# Copy to `.env` and replace the placeholders.
# PostgreSQL connection used by the app, migrations and seed.
DATABASE_URL="postgresql://<user>:<password>@localhost:5434/booking?schema=public"

# Separate database used ONLY by the automated tests (it is reset by the test setup).
TEST_DATABASE_URL="postgresql://<user>:<password>@localhost:5434/booking_test?schema=public"

# HTTP + Socket.IO port.
PORT=3000
